<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#131625"
    android:padding="12dp"
    android:layout_marginBottom="12dp">

    <!-- Card Header: App Name and Trigger Badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <!-- App Icon/Name Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentStart="true">

            <!-- App Name Label -->
            <TextView
                android:id="@+id/item_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WhatsApp"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Trigger Pill Badge -->
        <TextView
            android:id="@+id/item_trigger_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="App Switch"
            android:textColor="#06B6D4"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#0A2F3D"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- Screenshot Image View -->
    <ImageView
        android:id="@+id/item_image"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:scaleType="centerCrop"
        android:background="#07080C"
        android:layout_marginBottom="8dp" />

    <!-- Card Footer: Time info -->
    <TextView
        android:id="@+id/item_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Captured: 02:25:30 PM"
        android:textColor="#949DB0"
        android:textSize="11sp"
        android:textStyle="italic" />

</LinearLayout>
