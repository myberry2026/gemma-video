<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="110dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginEnd="10dp"
    android:background="#1B1E2E"
    android:padding="4dp">

    <!-- Screen Preview -->
    <ImageView
        android:id="@+id/screenshot_preview"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:scaleType="centerCrop"
        android:background="#07080C" />

    <!-- Capture Details Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="2dp">

        <View
            android:id="@+id/view_trigger_indicator"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="#06B6D4"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/text_screenshot_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:42 PM"
            android:textColor="#949DB0"
            android:textSize="10sp"
            android:ellipsize="end"
            android:maxLines="1" />
    </LinearLayout>

</LinearLayout>
