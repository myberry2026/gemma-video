<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#131625"
    android:padding="12dp"
    android:layout_marginBottom="16dp">

    <!-- App Group Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/group_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WhatsApp"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/group_screenshot_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="5 screenshots"
            android:textColor="#C084FC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#1E1B4B"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <!-- Gemma curation summary (shown only when curated) -->
    <TextView
        android:id="@+id/group_gemma_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#E0E7FF"
        android:textSize="12sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone" />

    <!-- Horizontal RecyclerView for screenshots -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_horizontal_screenshots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:scrollbars="none" />

</LinearLayout>
